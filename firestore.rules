rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Primitives ---

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isBootstrappedAdminEmail() {
      return isVerifiedUser() && request.auth.token.email == 'jellyzizy@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdminEmail()
        || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSlug(slug) {
      return slug is string && slug.size() >= 1 && slug.size() <= 140 && slug.matches('^[a-z0-9\\-]+$');
    }

    function isSafeHttpsUrl(url) {
      return url == '' || (url is string && url.size() <= 500 && url.matches('^https://[^\\s<>"]+$'));
    }

    function isSafeMediaUrl(url) {
      return url == '' || (
        url is string && (
          url.matches('^https://[^\\s<>"]+$')
          || url.matches('^/[^/\\s<>][^\\s<>"]*$')
          || url.matches('^data:image/(png|jpeg|jpg|webp|gif);base64,[A-Za-z0-9+/=]+$')
        )
      );
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.role in ['customer', 'admin']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.grantedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'description', 'sortOrder', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'slug', 'description', 'sortOrder', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && isValidSlug(data.slug)
        && data.description is string && data.description.size() <= 280
        && data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'id', 'name', 'slug', 'description', 'price', 'categoryId', 'categoryName',
          'previewImages', 'featured', 'bestSeller', 'newArrival', 'published',
          'productType', 'fileFormat', 'contentsSummary', 'downloadableAssetKey',
          'popularityScore', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'slug', 'description', 'price', 'salePrice', 'categoryId', 'categoryName',
          'previewImages', 'featured', 'bestSeller', 'newArrival', 'published',
          'productType', 'fileFormat', 'contentsSummary', 'downloadableAssetKey',
          'popularityScore', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && isValidSlug(data.slug)
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 2500
        && data.price is number && data.price >= 0 && data.price <= 9999
        && (!('salePrice' in data) || data.salePrice == null || (data.salePrice is number && data.salePrice >= 0 && data.salePrice < data.price))
        && isValidId(data.categoryId)
        && data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 60
        && data.previewImages is list && data.previewImages.size() >= 1 && data.previewImages.size() <= 6
        && data.previewImages[0] is string && data.previewImages[0].size() >= 1 && data.previewImages[0].size() <= 300000
        && isSafeMediaUrl(data.previewImages[0])
        && data.featured is bool
        && data.bestSeller is bool
        && data.newArrival is bool
        && data.published is bool
        && data.productType in ['individual_pack', 'bundle', 'printable_pack']
        && data.fileFormat is string && data.fileFormat.size() >= 1 && data.fileFormat.size() <= 120
        && data.contentsSummary is string && data.contentsSummary.size() >= 1 && data.contentsSummary.size() <= 500
        && data.downloadableAssetKey is string && data.downloadableAssetKey.size() >= 1 && data.downloadableAssetKey.size() <= 180
        && data.popularityScore is number && data.popularityScore >= 0 && data.popularityScore <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPaymentMethod(data) {
      return data.keys().hasAll([
          'id', 'name', 'type', 'enabled', 'accountHolderName', 'bankName',
          'accountNumber', 'paypalLink', 'qrisImageUrl', 'description',
          'instructions', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'type', 'enabled', 'accountHolderName', 'bankName',
          'accountNumber', 'paypalLink', 'qrisImageUrl', 'description',
          'instructions', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.type in ['bank_transfer', 'qris', 'paypal', 'other']
        && data.enabled is bool
        && data.accountHolderName is string && data.accountHolderName.size() <= 120
        && data.bankName is string && data.bankName.size() <= 120
        && data.accountNumber is string && data.accountNumber.size() <= 80
        && data.paypalLink is string && isSafeHttpsUrl(data.paypalLink)
        && data.qrisImageUrl is string && data.qrisImageUrl.size() <= 300000 && isSafeMediaUrl(data.qrisImageUrl)
        && data.description is string && data.description.size() <= 500
        && data.instructions is string && data.instructions.size() <= 2000
        && data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPaymentAdminConfig(data) {
      return data.keys().hasAll([
          'id', 'notificationEmail', 'internalPaymentNotes',
          'requireReferenceFormatHint', 'updatedBy', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'notificationEmail', 'internalPaymentNotes',
          'requireReferenceFormatHint', 'updatedBy', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.notificationEmail is string && data.notificationEmail.size() <= 254
        && data.internalPaymentNotes is string && data.internalPaymentNotes.size() <= 2000
        && data.requireReferenceFormatHint is string && data.requireReferenceFormatHint.size() <= 300
        && data.updatedBy is string && data.updatedBy.size() <= 120
        && data.updatedAt is timestamp;
    }

    function isValidPaymentSnapshot(snap) {
      return snap is map
        && snap.keys().hasAll([
          'id', 'name', 'type', 'accountHolderName', 'bankName',
          'accountNumber', 'paypalLink', 'qrisImageUrl', 'description', 'instructions'
        ])
        && snap.keys().hasOnly([
          'id', 'name', 'type', 'accountHolderName', 'bankName',
          'accountNumber', 'paypalLink', 'qrisImageUrl', 'description', 'instructions'
        ])
        && isValidId(snap.id)
        && snap.name is string && snap.name.size() >= 1 && snap.name.size() <= 100
        && snap.type in ['bank_transfer', 'qris', 'paypal', 'other']
        && snap.accountHolderName is string && snap.accountHolderName.size() <= 120
        && snap.bankName is string && snap.bankName.size() <= 120
        && snap.accountNumber is string && snap.accountNumber.size() <= 80
        && snap.paypalLink is string && isSafeHttpsUrl(snap.paypalLink)
        && snap.qrisImageUrl is string && snap.qrisImageUrl.size() <= 300000 && isSafeMediaUrl(snap.qrisImageUrl)
        && snap.description is string && snap.description.size() <= 500
        && snap.instructions is string && snap.instructions.size() <= 2000;
    }

    function isValidVerificationHistoryList(list) {
      return list is list && list.size() <= 25
        && (list.size() == 0 || (
          list[0] is map
          && list[0].keys().hasAll(['action', 'by', 'reason', 'at'])
          && list[0].keys().hasOnly(['action', 'by', 'reason', 'at'])
          && list[0].action in ['approved', 'rejected', 'status_updated']
          && list[0].by is string && list[0].by.size() <= 120
          && list[0].reason is string && list[0].reason.size() <= 500
          && list[0].at is string && list[0].at.size() <= 64
        ));
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'id', 'orderNumber', 'userId', 'customerName', 'customerEmail', 'customerCountry',
          'subtotal', 'total', 'currency', 'orderStatus', 'paymentStatus',
          'paymentReference', 'downloadAuthorized', 'itemCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'orderNumber', 'userId', 'customerName', 'customerEmail', 'customerCountry',
          'customerWhatsapp', 'customerNote', 'checkoutChannel',
          'productIds', 'productNames', 'quantities', 'unitPrices',
          'subtotal', 'total', 'currency', 'orderStatus', 'paymentStatus',
          'paymentMethodId', 'paymentMethodName', 'paymentMethodType', 'paymentMethodSnapshot',
          'paymentReference', 'customerPaymentNote', 'paymentProofUrl', 'paymentSubmittedAt',
          'rejectionReason', 'verifiedBy', 'verifiedAt', 'verificationHistory',
          'downloadAuthorized', 'itemCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 32
        && isValidId(data.userId)
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 254
        && data.customerCountry is string && data.customerCountry.size() <= 80
        && (!('customerWhatsapp' in data) || (data.customerWhatsapp is string && data.customerWhatsapp.size() <= 40))
        && (!('customerNote' in data) || (data.customerNote is string && data.customerNote.size() <= 500))
        && (!('checkoutChannel' in data) || data.checkoutChannel in ['whatsapp', 'manual_payment'])
        && (!('productIds' in data) || (data.productIds is list && data.productIds.size() >= 1 && data.productIds.size() <= 30 && data.productIds[0] is string && data.productIds[0].size() <= 128))
        && (!('productNames' in data) || (data.productNames is list && data.productNames.size() >= 1 && data.productNames.size() <= 30 && data.productNames[0] is string && data.productNames[0].size() <= 120))
        && (!('quantities' in data) || (data.quantities is list && data.quantities.size() >= 1 && data.quantities.size() <= 30 && data.quantities[0] is number && data.quantities[0] >= 1 && data.quantities[0] <= 25))
        && (!('unitPrices' in data) || (data.unitPrices is list && data.unitPrices.size() >= 1 && data.unitPrices.size() <= 30 && data.unitPrices[0] is number && data.unitPrices[0] >= 0 && data.unitPrices[0] <= 9999))
        && data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 100000
        && data.total is number && data.total >= 0 && data.total <= 100000
        && data.total == data.subtotal
        && data.currency == 'USD'
        && data.orderStatus in ['pending_contact', 'pending', 'confirmed', 'processing', 'completed', 'cancelled', 'paid', 'failed', 'refunded']
        && data.paymentStatus in ['unpaid', 'awaiting_verification', 'paid', 'rejected', 'pending', 'failed', 'refunded']
        && (!('paymentMethodId' in data) || (data.paymentMethodId is string && data.paymentMethodId.size() <= 64))
        && (!('paymentMethodName' in data) || (data.paymentMethodName is string && data.paymentMethodName.size() <= 100))
        && (!('paymentMethodType' in data) || data.paymentMethodType in ['bank_transfer', 'qris', 'paypal', 'other', ''])
        && (!('paymentMethodSnapshot' in data) || data.paymentMethodSnapshot == null || isValidPaymentSnapshot(data.paymentMethodSnapshot))
        && data.paymentReference is string && data.paymentReference.size() <= 160
        && (!('customerPaymentNote' in data) || (data.customerPaymentNote is string && data.customerPaymentNote.size() <= 500))
        && (!('paymentProofUrl' in data) || (data.paymentProofUrl is string && isSafeHttpsUrl(data.paymentProofUrl)))
        && (!('paymentSubmittedAt' in data) || (data.paymentSubmittedAt is string && data.paymentSubmittedAt.size() <= 64))
        && (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 500))
        && (!('verifiedBy' in data) || (data.verifiedBy is string && data.verifiedBy.size() <= 120))
        && (!('verifiedAt' in data) || (data.verifiedAt is string && data.verifiedAt.size() <= 64))
        && (!('verificationHistory' in data) || isValidVerificationHistoryList(data.verificationHistory))
        && data.downloadAuthorized is bool
        && data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrderItemPriceAgainstCatalog(productId, priceSnapshot) {
      return !exists(/databases/$(database)/documents/products/$(productId))
        || (
          get(/databases/$(database)/documents/products/$(productId)).data.published == true
          && (
            (get(/databases/$(database)/documents/products/$(productId)).data.salePrice != null
              && priceSnapshot == get(/databases/$(database)/documents/products/$(productId)).data.salePrice)
            || (get(/databases/$(database)/documents/products/$(productId)).data.salePrice == null
              && priceSnapshot == get(/databases/$(database)/documents/products/$(productId)).data.price)
          )
        );
    }

    function isValidOrderItem(data) {
      return data.keys().hasAll([
          'id', 'orderId', 'userId', 'productId', 'productName', 'productType',
          'fileFormat', 'priceSnapshot', 'quantity', 'previewImage', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'orderId', 'userId', 'productId', 'productName', 'productType',
          'fileFormat', 'priceSnapshot', 'quantity', 'previewImage', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.orderId)
        && isValidId(data.userId)
        && isValidId(data.productId)
        && data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 120
        && data.productType in ['individual_pack', 'bundle', 'printable_pack']
        && data.fileFormat is string && data.fileFormat.size() >= 1 && data.fileFormat.size() <= 120
        && data.priceSnapshot is number && data.priceSnapshot >= 0 && data.priceSnapshot <= 9999
        && data.quantity is number && data.quantity >= 1 && data.quantity <= 50
        && data.previewImage is string && data.previewImage.size() <= 300000 && isSafeMediaUrl(data.previewImage)
        && data.createdAt is timestamp;
    }

    function isValidDownloadAccess(data) {
      return data.keys().hasAll([
          'id', 'orderId', 'userId', 'productId', 'productName', 'assetKey',
          'fileFormat', 'authorized', 'downloadCount', 'maxDownloads', 'grantedBy',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'orderId', 'userId', 'productId', 'productName', 'assetKey',
          'fileFormat', 'authorized', 'downloadCount', 'maxDownloads', 'grantedBy',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.orderId)
        && isValidId(data.userId)
        && isValidId(data.productId)
        && data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 120
        && data.assetKey is string && data.assetKey.size() >= 1 && data.assetKey.size() <= 180
        && data.fileFormat is string && data.fileFormat.size() >= 1 && data.fileFormat.size() <= 120
        && data.authorized is bool
        && data.downloadCount is number && data.downloadCount >= 0 && data.downloadCount <= 100
        && data.maxDownloads is number && data.maxDownloads >= 1 && data.maxDownloads <= 50
        && data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminAuditLog(data) {
      return data.keys().hasAll(['id', 'action', 'actorEmail', 'summary', 'details', 'createdAt'])
        && data.keys().hasOnly(['id', 'action', 'actorEmail', 'summary', 'details', 'createdAt'])
        && isValidId(data.id)
        && data.action in ['backup_restore', 'catalog_sync', 'preview_migration']
        && data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 120
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 200
        && data.details is string && data.details.size() <= 1000
        && data.createdAt is timestamp;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdminEmail();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == userId
        && incoming().role == 'customer'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isBootstrappedAdminEmail();
      allow create: if isValidId(uid)
        && isBootstrappedAdminEmail()
        && isValidAdmin(incoming())
        && incoming().uid == uid
        && incoming().grantedAt == request.time;
      allow update: if false;
      allow delete: if isValidId(uid) && isBootstrappedAdminEmail();
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if existing().sortOrder >= 0;
      allow create: if isValidId(categoryId)
        && isAdmin()
        && isValidCategory(incoming())
        && incoming().id == categoryId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(categoryId)
        && isAdmin()
        && isValidCategory(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'description', 'sortOrder', 'updatedAt']);
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    match /products/{productId} {
      allow get: if isValidId(productId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true || isBootstrappedAdminEmail();
      allow create: if isValidId(productId)
        && isAdmin()
        && isValidProduct(incoming())
        && incoming().id == productId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(productId)
        && isAdmin()
        && isValidProduct(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'slug', 'description', 'price', 'salePrice', 'categoryId', 'categoryName',
          'previewImages', 'featured', 'bestSeller', 'newArrival', 'published',
          'productType', 'fileFormat', 'contentsSummary', 'downloadableAssetKey',
          'popularityScore', 'updatedAt'
        ]);
      allow delete: if isValidId(productId) && isAdmin();
    }

    match /paymentMethods/{methodId} {
      allow get: if isValidId(methodId) && (existing().enabled == true || isAdmin());
      allow list: if existing().enabled == true || isBootstrappedAdminEmail();
      allow create: if isValidId(methodId)
        && isAdmin()
        && isValidPaymentMethod(incoming())
        && incoming().id == methodId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(methodId)
        && isAdmin()
        && isValidPaymentMethod(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'type', 'enabled', 'accountHolderName', 'bankName',
          'accountNumber', 'paypalLink', 'qrisImageUrl', 'description',
          'instructions', 'sortOrder', 'updatedAt'
        ]);
      allow delete: if isValidId(methodId) && isAdmin();
    }

    match /paymentAdminConfig/{configId} {
      allow get: if isValidId(configId) && isAdmin();
      allow list: if isBootstrappedAdminEmail();
      allow create: if isValidId(configId)
        && isAdmin()
        && isValidPaymentAdminConfig(incoming())
        && incoming().id == configId
        && incoming().updatedAt == request.time;
      allow update: if isValidId(configId)
        && isAdmin()
        && isValidPaymentAdminConfig(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'notificationEmail', 'internalPaymentNotes',
          'requireReferenceFormatHint', 'updatedBy', 'updatedAt'
        ]);
      allow delete: if isValidId(configId) && isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isOwner(existing().userId) || isAdmin());
      allow list: if isOwner(existing().userId) || isBootstrappedAdminEmail();
      allow create: if isValidId(orderId)
        && isVerifiedUser()
        && isValidOrder(incoming())
        && incoming().id == orderId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            incoming().userId == request.auth.uid
            && incoming().paymentStatus == 'unpaid'
            && incoming().paymentReference == ''
            && incoming().customerPaymentNote == ''
            && incoming().paymentProofUrl == ''
            && incoming().paymentSubmittedAt == ''
            && incoming().rejectionReason == ''
            && incoming().verifiedBy == ''
            && incoming().verifiedAt == ''
            && incoming().verificationHistory is list && incoming().verificationHistory.size() == 0
            && incoming().downloadAuthorized == false
            && existsAfter(/databases/$(database)/documents/orderItems/$(orderId + '-item-1'))
            && getAfter(/databases/$(database)/documents/orderItems/$(orderId + '-item-1')).data.orderId == orderId
            && getAfter(/databases/$(database)/documents/orderItems/$(orderId + '-item-1')).data.userId == request.auth.uid
            && getAfter(/databases/$(database)/documents/orderItems/$(orderId + '-item-1')).data.priceSnapshot
                * getAfter(/databases/$(database)/documents/orderItems/$(orderId + '-item-1')).data.quantity
                <= incoming().total + 0.01
            && (
              (
                incoming().orderStatus == 'pending_contact'
                && incoming().checkoutChannel == 'whatsapp'
                && incoming().paymentMethodId == ''
                && incoming().paymentMethodSnapshot == null
              )
              || (
                incoming().orderStatus == 'pending'
                && isValidId(incoming().paymentMethodId)
                && incoming().paymentMethodSnapshot != null
                && exists(/databases/$(database)/documents/paymentMethods/$(incoming().paymentMethodId))
                && get(/databases/$(database)/documents/paymentMethods/$(incoming().paymentMethodId)).data.enabled == true
              )
            )
          )
        );
      allow update: if isValidId(orderId)
        && isSignedIn()
        && isValidOrder(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().orderNumber == existing().orderNumber
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'orderStatus', 'paymentStatus', 'paymentReference',
              'rejectionReason', 'verifiedBy', 'verifiedAt',
              'verificationHistory', 'downloadAuthorized',
              'customerName', 'customerEmail', 'customerCountry',
              'customerWhatsapp', 'customerNote', 'customerPaymentNote',
              'paymentProofUrl', 'paymentSubmittedAt', 'paymentMethodId',
              'paymentMethodName', 'paymentMethodType', 'paymentMethodSnapshot',
              'subtotal', 'total', 'itemCount', 'checkoutChannel',
              'productIds', 'productNames', 'quantities', 'unitPrices',
              'updatedAt'
            ])
          )
          || (
            isOwner(existing().userId)
            && existing().orderStatus == 'pending'
            && (
              existing().paymentStatus == 'unpaid'
              || existing().paymentStatus == 'rejected'
              || existing().paymentStatus == 'pending'
            )
            && incoming().orderStatus == 'pending'
            && incoming().paymentStatus == 'awaiting_verification'
            && incoming().downloadAuthorized == false
            && incoming().paymentReference.size() >= 2
            && incoming().subtotal == existing().subtotal
            && incoming().total == existing().total
            && incoming().itemCount == existing().itemCount
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'paymentStatus', 'paymentReference', 'customerPaymentNote',
              'paymentProofUrl', 'paymentSubmittedAt', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(orderId) && isAdmin();
    }

    match /orderItems/{orderItemId} {
      allow get: if isValidId(orderItemId) && (isOwner(existing().userId) || isAdmin());
      allow list: if isOwner(existing().userId) || isBootstrappedAdminEmail();
      allow create: if isValidId(orderItemId)
        && isVerifiedUser()
        && isValidOrderItem(incoming())
        && incoming().id == orderItemId
        && incoming().createdAt == request.time
        && (
          (
            isAdmin()
            && (
              exists(/databases/$(database)/documents/orders/$(incoming().orderId))
              || existsAfter(/databases/$(database)/documents/orders/$(incoming().orderId))
            )
          )
          || (
            incoming().userId == request.auth.uid
            && isValidOrderItemPriceAgainstCatalog(incoming().productId, incoming().priceSnapshot)
            && existsAfter(/databases/$(database)/documents/orders/$(incoming().orderId))
            && getAfter(/databases/$(database)/documents/orders/$(incoming().orderId)).data.userId == request.auth.uid
          )
        );
      allow update: if false;
      allow delete: if isValidId(orderItemId) && isAdmin();
    }

    match /downloadAccess/{accessId} {
      allow get: if isValidId(accessId) && (isOwner(existing().userId) || isAdmin());
      allow list: if isOwner(existing().userId) || isBootstrappedAdminEmail();
      allow create: if isValidId(accessId)
        && isAdmin()
        && isValidDownloadAccess(incoming())
        && incoming().id == accessId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/orders/$(incoming().orderId));
      allow update: if isValidId(accessId)
        && isAdmin()
        && isValidDownloadAccess(incoming())
        && incoming().id == existing().id
        && incoming().orderId == existing().orderId
        && incoming().userId == existing().userId
        && incoming().productId == existing().productId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'authorized', 'downloadCount', 'maxDownloads', 'grantedBy', 'updatedAt'
        ]);
      allow delete: if isValidId(accessId) && isAdmin();
    }

    match /adminAuditLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isBootstrappedAdminEmail();
      allow create: if isValidId(logId)
        && isAdmin()
        && isValidAdminAuditLog(incoming())
        && incoming().id == logId
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
