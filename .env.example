# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_FIREBASE_APP_CHECK_SITE_KEY: Optional public reCAPTCHA v3 Site Key from
# Firebase Console -> App Check -> Apps -> Register reCAPTCHA v3.
# Never put reCAPTCHA secret keys in VITE_* variables or frontend bundles.
VITE_FIREBASE_APP_CHECK_SITE_KEY=""

# VITE_APPCHECK_DEBUG_TOKEN: Optional local development App Check debug token (dev only).
VITE_APPCHECK_DEBUG_TOKEN=""
